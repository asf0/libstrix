# Copy to .env in this folder. Host directory holding the model folders
# (mounted read-only at /models); a model missing there is downloaded from
# Hugging Face into CACHE.
MODELS=/path/to/models
# torch.compile / Triton / Hugging Face cache; keep it so restarts skip
# recompiling.
CACHE=./cache
PORT=8000
# Hugging Face token, for gated models (gemma-4) that are not under MODELS.
HF_TOKEN=
# Optional overrides for any recipe: GPU_UTIL, MAX_MODEL_LEN, MAX_NUM_SEQS,
# MAX_BATCHED_TOKENS, MTP (draft tokens, 0 = off), SERVED_MODEL_NAME,
# REPLAYSSM, STRIX_DISABLE, STRIX_ENABLE, EXTRA_ARGS (appended to vllm
# serve), IMAGE, STRIX_MIN_AVAIL_GB (vLLM is stopped below this much free
# host RAM; default 10) and STRIX_MIN_GPU_FREE_GB (or below this much free
# GPU memory cap; default 14). Both protect the machine from an
# out-of-memory hang.
